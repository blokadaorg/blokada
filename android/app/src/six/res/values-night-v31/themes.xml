<!-- Android 12+ ignores windowBackground for the launch screen and crops the
     launcher icon to a circle instead, so give it the logo and background explicitly. -->
<resources>
    <style name="Theme.Blokada.Default" parent="Theme.Blokada.Dark">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBackground">@color/dark_background</item>
    </style>
</resources>
