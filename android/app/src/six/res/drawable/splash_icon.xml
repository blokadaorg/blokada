<!-- Android 12+ splash icon. The system stretches it over a 288dp canvas and
     shows only a 192dp circle, so the inset keeps the logo whole and at the
     icon_huge size (72dp) of the in-app splash overlay that follows it. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/blokada_logo"
    android:inset="37.5%" />
