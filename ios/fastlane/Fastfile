# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Six: build release"
  lane :build_ios_six do
    build_app(
      workspace: "IOS.xcworkspace",
      scheme: "Prod",
      export_options: {
        provisioningProfiles: {
          "net.blocka.app" => "match AppStore net.blocka.app",
          "net.blocka.app.family" => "match AppStore net.blocka.app.family",
          "net.blocka.app.network-extension" => "match AppStore net.blocka.app.network-extension",
          "net.blocka.app.web-extension" => "match AppStore net.blocka.app.web-extension"
        }
      }
    )
  end

  desc "Family: build release"
  lane :build_ios_family do
    build_app(workspace: "IOS.xcworkspace", scheme: "FamilyProd")
  end

  # Release path: attach an already-uploaded build to an App Store version.
  #
  # skip_binary_upload with build_number promotes rather than re-uploads, so we
  # ship the exact binary that has been on TestFlight. app_version must be the
  # name baked in at build time -- deliver looks a build up by the pair.
  #
  # automatic_release: false leaves an approved build in Pending Developer
  # Release. Publishing is always a manual click.
  #
  # Export compliance needs no entry here: ITSAppUsesNonExemptEncryption is
  # already <false/> in Info-six.plist and Info-family.plist, so App Store
  # Connect never asks.
  lane :publish_ios_six do |options|
    deliver(
      app_identifier: "net.blocka.app",
      metadata_path: "../metadata/ios-six/",
      api_key_path: "./blokada-appstore.json",
      app_version: options[:version_name],
      build_number: options[:build_number],
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      force: true, # skips verification of HTML preview file
      run_precheck_before_submit: false, # not supported through ASC API yet
      submit_for_review: options[:submit_for_review] == "true",
      automatic_release: false,
      submission_information: {
        content_rights_contains_third_party_content: false
      }
    )
  end

  lane :publish_ios_family do |options|
    deliver(
      app_identifier: "net.blocka.app.family",
      metadata_path: "../metadata/ios-family/",
      api_key_path: "./blokada-appstore.json",
      app_version: options[:version_name],
      build_number: options[:build_number],
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: options[:submit_for_review] == "true",
      automatic_release: false,
      submission_information: {
        content_rights_contains_third_party_content: false
      }
    )
  end

  # Continuous path: upload to TestFlight only, run on every merge to main.
  #
  # Deliberately NOT deliver. deliver creates an App Store version record per
  # run, which would produce hundreds of junk versions and hard-fail with
  # "You cannot create a new version of the App in the current state" whenever
  # a release is sitting in Pending Developer Release. TestFlight needs no
  # version record.
  lane :upload_testflight_six do
    upload_to_testflight(
      ipa: "Blokada 6.ipa",
      app_identifier: "net.blocka.app",
      api_key_path: "./blokada-appstore.json",
      skip_submission: true,                    # no external beta review
      skip_waiting_for_build_processing: true   # keep CI fast
    )
  end

  lane :upload_testflight_family do
    upload_to_testflight(
      ipa: "Blokada Family.ipa",
      app_identifier: "net.blocka.app.family",
      api_key_path: "./blokada-appstore.json",
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
  end
end
