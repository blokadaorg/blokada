{
  "extraKnownMarketplaces": {
    "blokada-workflows": {
      "source": { "source": "github", "repo": "blokadaorg/workflows" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "blokada@blokada-workflows": true
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "900000"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(dart run:*)",
      "Bash(fastlane match:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter build:*)",
      "Bash(flutter packages pub run build_runner:*)",
      "Bash(flutter test:*)",
      "Bash(fvm dart run build_runner build:*)",
      "Bash(fvm flutter:*)",
      "Bash(fvm list:*)",
      "Bash(fvm use:*)",
      "Bash(make build:*)",
      "Bash(make clean:*)",
      "Bash(make gen)",
      "Bash(make install:*)",
      "Bash(make regen:*)",
      "Bash(make test:*)",
      "Bash(make uninstall)",
      "Bash(make -C ios run:*)",
      "Bash(xcrun devicectl list:*)",
      "Bash(xcodebuild:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "timeout": 600,
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || exit 0; bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-setup.sh\" >>/tmp/cloud-setup-hook.log 2>&1 || echo \"scripts/cloud-setup.sh failed, see /tmp/cloud-setup-hook.log\""
          }
        ]
      }
    ]
  }
}
